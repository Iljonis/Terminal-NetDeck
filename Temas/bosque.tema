# Bosque — Verdes musgo, cielo y tonos cálidos (estilo Ghibli).
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Bosque
grupo     = Anime y cine
orden     = 13
fuentes   = Inconsolata, Fragment Mono, DM Mono      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #14201a                  # fondo de la ventana de Terminal
texto         = #eef3e2                  # texto normal
barra         = #0f1913                  # barra de pestañas y de botones
panel         = #223527                  # pestañas y botones inactivos
pestaña       = #9bd36f                  # pestaña activa
sobre_pestaña = #14201a                  # texto sobre la pestaña activa
acento        = #f6d58e                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #7cc7e8                  # IPs, rutas, enlaces
bien          = #9bd36f                  # up, established, 0% loss
mal           = #e8755c                  # down, errores, alarmas
especial      = #e9a7c5                  # dBm, MAC, rosa/morado
apagado       = #738a76                  # fechas, descripciones, @ del prompt
menu          = ✿ Menú                   # texto del botón de menú (arriba a la derecha)
reloj         = 森 %H:%M                  # formato del reloj (%H:%M = hora:minutos)
