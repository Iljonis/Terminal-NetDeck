# Corpo rojo — Negro, rojo corporativo y blanco. Sobrio, con rótulos en kanji.
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Corpo rojo
grupo     = Cyberpunk
orden     = 02
fuentes   = IBM Plex Mono, Red Hat Mono, Geist Mono      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #0b0b0c                  # fondo de la ventana de Terminal
texto         = #e9e9ea                  # texto normal
barra         = #000000                  # barra de pestañas y de botones
panel         = #1a1a1c                  # pestañas y botones inactivos
pestaña       = #e4002b                  # pestaña activa
sobre_pestaña = #ffffff                  # texto sobre la pestaña activa
acento        = #ffffff                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #ff4d6d                  # IPs, rutas, enlaces
bien          = #c9f2d7                  # up, established, 0% loss
mal           = #ff2b3d                  # down, errores, alarmas
especial      = #ff8a9a                  # dBm, MAC, rosa/morado
apagado       = #6e6e73                  # fechas, descripciones, @ del prompt
menu          = ▌企業 · ☰ Menú             # texto del botón de menú (arriba a la derecha)
reloj         = 時 %H:%M                  # formato del reloj (%H:%M = hora:minutos)
