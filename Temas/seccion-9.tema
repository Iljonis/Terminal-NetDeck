# Sección 9 — Verde agua y blanco sobre pizarra (estilo Ghost in the Shell).
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Sección 9
grupo     = Anime y cine
orden     = 12
fuentes   = B612 Mono, Share Tech Mono, Kode Mono      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #0b1414                  # fondo de la ventana de Terminal
texto         = #dff7f2                  # texto normal
barra         = #081010                  # barra de pestañas y de botones
panel         = #14302d                  # pestañas y botones inactivos
pestaña       = #2ee6c5                  # pestaña activa
sobre_pestaña = #0b1414                  # texto sobre la pestaña activa
acento        = #a5fff0                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #2ee6c5                  # IPs, rutas, enlaces
bien          = #62f5a2                  # up, established, 0% loss
mal           = #ff6b6b                  # down, errores, alarmas
especial      = #8fb8ff                  # dBm, MAC, rosa/morado
apagado       = #4f7a74                  # fechas, descripciones, @ del prompt
menu          = 公安9課 · ☰ Menú            # texto del botón de menú (arriba a la derecha)
reloj         = %H:%M                    # formato del reloj (%H:%M = hora:minutos)
