# DIGI — Azul DIGI Mobil (#1275B7) y el punto rojo del logo, sobre azul marino.
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.
# (Colores inspirados en la marca; ajusta los #hex si tienes el manual de marca de tu empresa.)

nombre    = DIGI
grupo     = Corporativas
orden     = 25
fuentes   = Roboto Mono, Fira Code, JetBrains Mono      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #07152a                  # fondo de la ventana de Terminal
texto         = #e8f1fa                  # texto normal
barra         = #0a1b33                  # barra de pestañas y de botones
panel         = #13294a                  # pestañas y botones inactivos
pestaña       = #1275b7                  # pestaña activa
sobre_pestaña = #ffffff                  # texto sobre la pestaña activa
acento        = #4db2ff                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #7fdcff                  # IPs, rutas, enlaces
bien          = #3ddc97                  # up, established, 0% loss
mal           = #ff4d57                  # down, errores, alarmas
especial      = #ff8fb1                  # dBm, MAC, rosa/morado
apagado       = #7089a8                  # fechas, descripciones, @ del prompt
menu          = ● Menú                   # texto del botón de menú (arriba a la derecha)
reloj         = %H:%M                    # formato del reloj (%H:%M = hora:minutos)
