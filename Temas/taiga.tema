# Taiga — Verde bosque apagado con salvia, arena y musgo (inspirada en Everforest): suave y muy cálida.
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Taiga
grupo     = Sobrias
orden     = 44
fuentes   = Inconsolata, Fragment Mono, DM Mono      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #2d353b                  # fondo de la ventana de Terminal
texto         = #d3c6aa                  # texto normal
barra         = #232a2e                  # barra de pestañas y de botones
panel         = #3d484d                  # pestañas y botones inactivos
pestaña       = #a7c080                  # pestaña activa
sobre_pestaña = #232a2e                  # texto sobre la pestaña activa
acento        = #dbbc7f                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #7fbbb3                  # IPs, rutas, enlaces
bien          = #a7c080                  # up, established, 0% loss
mal           = #e67e80                  # down, errores, alarmas
especial      = #d699b6                  # dBm, MAC, rosa/morado
apagado       = #8f9a90                  # fechas, descripciones, @ del prompt
menu          = ☰ Menú                   # texto del botón de menú (arriba a la derecha)
reloj         = %H:%M                    # formato del reloj (%H:%M = hora:minutos)
ansi          = #475258, #e67e80, #a7c080, #dbbc7f, #7fbbb3, #d699b6, #83c092, #d3c6aa, #859289, #f09496, #bcd398, #e8cd96, #97cdc6, #e3b0c8, #9bd2a8, #ede0c4
