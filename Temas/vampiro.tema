# Vampiro — Morado, rosa y verde sobre gris (estilo Dracula).
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Vampiro
grupo     = Sobrias
orden     = 21
fuentes   = Source Code Pro, Fira Code, Roboto Mono      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #21222c                  # fondo de la ventana de Terminal
texto         = #f8f8f2                  # texto normal
barra         = #191a21                  # barra de pestañas y de botones
panel         = #343746                  # pestañas y botones inactivos
pestaña       = #bd93f9                  # pestaña activa
sobre_pestaña = #21222c                  # texto sobre la pestaña activa
acento        = #f1fa8c                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #8be9fd                  # IPs, rutas, enlaces
bien          = #50fa7b                  # up, established, 0% loss
mal           = #ff5555                  # down, errores, alarmas
especial      = #ff79c6                  # dBm, MAC, rosa/morado
apagado       = #7b80a3                  # fechas, descripciones, @ del prompt
menu          = ☰ Menú                   # texto del botón de menú (arriba a la derecha)
reloj         = %H:%M                    # formato del reloj (%H:%M = hora:minutos)
