# Volcán oscuro — Roca negra y ríos de lava: naranja incandescente, azufre y ceniza.
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Volcán oscuro
grupo     = Naturaleza
orden     = 05
fuentes   = Martian Mono, JetBrains Mono, Fira Code      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #141110                  # fondo de la ventana de Terminal
texto         = #efe6e0                  # texto normal
barra         = #0e0b0a                  # barra de pestañas y de botones
panel         = #241d1a                  # pestañas y botones inactivos
pestaña       = #ff5a1f                  # pestaña activa
sobre_pestaña = #141110                  # texto sobre la pestaña activa
acento        = #ff8a3d                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #f2c14e                  # IPs, rutas, enlaces
bien          = #9ccf6a                  # up, established, 0% loss
mal           = #ff4d3d                  # down, errores, alarmas
especial      = #ff7ab0                  # dBm, MAC, rosa/morado
apagado       = #85766f                  # fechas, descripciones, @ del prompt
menu          = ☰ Menú                   # texto del botón de menú (arriba a la derecha)
reloj         = %H:%M                    # formato del reloj (%H:%M = hora:minutos)
ansi          = #241d1a, #ff4d3d, #9ccf6a, #f2c14e, #7aa0e0, #ff7ab0, #6fc8c8, #ddd2cb, #85766f, #ff7a6e, #b5db8f, #f5d07a, #9bb8e8, #ff9bc4, #93d6d6, #eee8e5
