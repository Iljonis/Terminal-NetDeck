# Pro — El perfil «Pro» de Terminal de macOS: texto claro sobre negro y los colores brillantes de siempre.
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Pro
grupo     = Prácticas
orden     = 31
fuentes   = Menlo, Monaco, JetBrains Mono      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14
prompt    = plano                        # prompts como en Terminal: usuario@equipo en negrita y verde, el resto en texto normal

fondo         = #000000                  # fondo de la ventana de Terminal
texto         = #f2f2f2                  # texto normal
barra         = #000000                  # barra de pestañas y de botones
panel         = #262626                  # pestañas y botones inactivos
pestaña       = #f2f2f2                  # pestaña activa
sobre_pestaña = #000000                  # texto sobre la pestaña activa
acento        = #e5e500                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #00e5e5                  # IPs, rutas, enlaces
bien          = #22e022                  # up, established, 0% loss
mal           = #ff4040                  # down, errores, alarmas
especial      = #e500e5                  # dBm, MAC, rosa/morado
apagado       = #999999                  # fechas, descripciones, @ del prompt
menu          = ☰ Menú                   # texto del botón de menú (arriba a la derecha)
reloj         = %H:%M                    # formato del reloj (%H:%M = hora:minutos)
