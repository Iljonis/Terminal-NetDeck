# Synthwave — Atardecer retrowave: rosa, violeta y naranja.
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Synthwave
grupo     = Cyberpunk
orden     = 04
fuentes   = Martian Mono, Kode Mono, Space Mono      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #1a0b2e                  # fondo de la ventana de Terminal
texto         = #ffe9f9                  # texto normal
barra         = #140823                  # barra de pestañas y de botones
panel         = #2e1250                  # pestañas y botones inactivos
pestaña       = #ff3cac                  # pestaña activa
sobre_pestaña = #1a0b2e                  # texto sobre la pestaña activa
acento        = #ffd319                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #2de2e6                  # IPs, rutas, enlaces
bien          = #72f1b8                  # up, established, 0% loss
mal           = #fe4450                  # down, errores, alarmas
especial      = #f97e72                  # dBm, MAC, rosa/morado
apagado       = #8b6fb0                  # fechas, descripciones, @ del prompt
menu          = ▲ Menú                   # texto del botón de menú (arriba a la derecha)
reloj         = ☼ %H:%M                  # formato del reloj (%H:%M = hora:minutos)
