# Neón Tokio — Cristal índigo sobre la ciudad de noche: pestaña magenta, interfaces en cian y el brillo de NetDeck.
# Temática de la app (estilo «cristal» con alma de neón: barra, pestañas y menús de vidrio; el terminal, casi opaco).

nombre    = Neón Tokio
grupo     = Neon Glass
orden     = 01
estilo    = cristal                      # cristal (macOS) · fluent (Windows 11) · neon (NetDeck)
material  = cristal                      # desenfoca lo que hay detrás de la ventana
brillo    = sí                           # halo de neón también en el estilo cristal
tinte     = #ff2e8826                    # tinte del cristal de pestañas y botones (26 ≈ 15 %)
fuentes   = JetBrains Mono, Kode Mono, Space Mono      # la 1ª es la oficial; las otras, recomendadas
fuente_interfaz = sistema                # la del Mac (SF Pro), como Liquid Glass
tamaño    = 14

fondo         = #0c0a22cc                # índigo casi negro (cc ≈ 80 %: el terminal se lee sobre cualquier escritorio)
texto         = #f2eeff
barra         = #1a0f3d66                # vidrio índigo (66 ≈ 40 %)
panel         = #2b1d5e80                # pestañas y botones inactivos (80 ≈ 50 %)
pestaña       = #ff2e88                  # pestaña activa: opaca, magenta neón
sobre_pestaña = #0b0a1f
acento        = #00e5ff                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #ff6eb4                  # IPs, rutas, enlaces
bien          = #5cffb0
mal           = #ff4d6a
especial      = #c3a0ff
apagado       = #8f88c9
menu          = ◢ NETDECK
reloj         = 東京 %H:%M
ansi          = #2a2550, #ff4d6a, #5cffb0, #ffe45c, #6aa8ff, #ff5fd2, #00e5ff, #d9d4f5, #6f68a8, #ff7a90, #8fffc8, #fff08a, #94c2ff, #ff8ee0, #6ff3ff, #ffffff
