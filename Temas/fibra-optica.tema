# Fibra óptica — Los colores de las fibras de un tubo (azul, naranja, verde, marrón, pizarra…) sobre azul noche (TIA-598).
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Fibra óptica
grupo     = Centro de datos
orden     = 02
fuentes   = Fira Code, JetBrains Mono, Source Code Pro      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #0b1220                  # fondo de la ventana de Terminal
texto         = #e8eef7                  # texto normal
barra         = #111a2c                  # barra de pestañas y de botones
panel         = #1a2540                  # pestañas y botones inactivos
pestaña       = #ff8c1a                  # pestaña activa
sobre_pestaña = #0b1220                  # texto sobre la pestaña activa
acento        = #3b82f6                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #ff8c1a                  # IPs, rutas, enlaces
bien          = #22c55e                  # up, established, 0% loss
mal           = #ef4444                  # down, errores, alarmas
especial      = #a855f7                  # dBm, MAC, rosa/morado
apagado       = #708090                  # fechas, descripciones, @ del prompt
menu          = ☰ Menú                   # texto del botón de menú (arriba a la derecha)
reloj         = %H:%M                    # formato del reloj (%H:%M = hora:minutos)
ansi          = #1a2540, #ef4444, #22c55e, #facc15, #3b82f6, #a855f7, #22d3ee, #e8eef7, #708090, #f37373, #59d486, #fbd950, #6ca1f8, #be80f9, #59def2, #f4f6fb
