# Fantasma rojo — Rojo, negro y blanco con contraste brutal (estilo Persona 5).
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Fantasma rojo
grupo     = Anime y cine
orden     = 10
fuentes   = Syne Mono, Roboto Mono, Azeret Mono      # la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #0a0a0a                  # fondo de la ventana de Terminal
texto         = #ffffff                  # texto normal
barra         = #000000                  # barra de pestañas y de botones
panel         = #2a0000                  # pestañas y botones inactivos
pestaña       = #e60012                  # pestaña activa
sobre_pestaña = #ffffff                  # texto sobre la pestaña activa
acento        = #ffffff                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #ff2a2a                  # IPs, rutas, enlaces
bien          = #ffd400                  # up, established, 0% loss
mal           = #ff2a2a                  # down, errores, alarmas
especial      = #ff8c8c                  # dBm, MAC, rosa/morado
apagado       = #8a8a8a                  # fechas, descripciones, @ del prompt
menu          = ★ Menú                   # texto del botón de menú (arriba a la derecha)
reloj         = TAKE YOUR TIME · %H:%M   # formato del reloj (%H:%M = hora:minutos)
