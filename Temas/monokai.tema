# Monokai — la de los editores de siempre: verde, amarillo y rosa intensos sobre gris oliva.
# Temática de NetDeck. Para crear la tuya: copia este archivo, cambia los colores y elígela en ☰ Menú → Temática.

nombre    = Monokai
grupo     = Retro
orden     = 39
fuentes   = Fira Code, JetBrains Mono, Source Code Pro# la 1ª es la oficial; las otras, recomendadas
tamaño    = 14

fondo         = #272822                  # fondo de la ventana de Terminal
texto         = #f8f8f2                  # texto normal
barra         = #1e1f1c                  # barra de pestañas y de botones
panel         = #3e3d32                  # pestañas y botones inactivos
pestaña       = #a6e22e                  # pestaña activa
sobre_pestaña = #272822                  # texto sobre la pestaña activa
acento        = #e6db74                  # interfaces, prompt del equipo, ☰ Menú, reloj
acento2       = #66d9ef                  # IPs, rutas, enlaces
bien          = #a6e22e                  # up, established, 0% loss
mal           = #f92672                  # down, errores, alarmas
especial      = #ae81ff                  # dBm, MAC, rosa/morado
apagado       = #75715e                  # fechas, descripciones, @ del prompt
menu          = ☰ Menú                   # texto del botón de menú
reloj         = %H:%M                    # formato del reloj
