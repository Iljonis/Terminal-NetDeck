<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador de Terminal NetDeck para Windows (WiX Toolset 4; ADR-0003, opcion B). Genera un .msi por maquina.

  Antes de compilar, windows/installer/preparar-instalador.ps1 reune los archivos en una carpeta (SourceDir):
      wix build windows/installer/NetDeckWindows.wxs <carpeta>/../archivos.wxs -arch x64 -d SourceDir=<carpeta> -o NetDeckWindows.msi

  Instala en C:\Program Files\Terminal NetDeck, crea el acceso del menu Inicio y, opcionalmente, el del escritorio
  (ADDLOCAL=Principal,AccesoEscritorio), y registra el Sparse Package de windows/Desktop/AppxManifest.xml para el usuario
  que instala. Quitar o actualizar lo desregistra antes de borrar los archivos.

  Compila con WiX 4.0.6 (herramienta de dotnet, no hace falta instalarlo en el sistema). La version
  (1.0.1) debe coincidir con AppxManifest.xml y con UpdateChecker.currentVersion. El UpgradeCode no se cambia nunca.
-->
<!-- La version sale de fuera en el CI (wix build -d Version=...); sin ella, esta. Debe coincidir con AppxManifest.xml y UpdateChecker.currentVersion. -->
<?ifndef Version?>
<?define Version = "1.0.1"?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Terminal NetDeck"
           Manufacturer="Iljonis"
           Version="$(var.Version)"
           UpgradeCode="864B0368-79B3-4687-8A69-102A5447C278"
           Scope="perMachine"
           Language="1034"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Ya hay una version mas reciente de Terminal NetDeck instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="NetDeckIcono" SourceFile="$(var.SourceDir)\Assets\NetDeck.ico" />
    <Property Id="ARPPRODUCTICON" Value="NetDeckIcono" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Terminal NetDeck" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- ArchivosDeLaApp (exe, dll de la app y del runtime de Swift, manifiesto, iconos y scripts) lo genera
         preparar-instalador.ps1 en archivos.wxs: WiX 4.0 no tiene el elemento Files. -->
    <Component Id="AccesoMenuInicio" Directory="ProgramMenuFolder">
      <Shortcut Id="AccesoMenuInicioDirecto" Name="Terminal NetDeck"
                Target="[INSTALLFOLDER]NetDeckWindows.exe" WorkingDirectory="INSTALLFOLDER" Icon="NetDeckIcono" />
      <RegistryValue Root="HKCU" Key="Software\Iljonis\TerminalNetDeck" Name="MenuInicio" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="AccesoEscritorioComp" Directory="DesktopFolder">
      <Shortcut Id="AccesoEscritorioDirecto" Name="Terminal NetDeck"
                Target="[INSTALLFOLDER]NetDeckWindows.exe" WorkingDirectory="INSTALLFOLDER" Icon="NetDeckIcono" />
      <RegistryValue Root="HKCU" Key="Software\Iljonis\TerminalNetDeck" Name="Escritorio" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Principal" Title="Terminal NetDeck" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ArchivosDeLaApp" />
      <ComponentRef Id="AccesoMenuInicio" />
    </Feature>
    <!-- Nivel 2: no se instala por defecto (no hay pantalla de eleccion; ADDLOCAL=Principal,AccesoEscritorio lo activa). -->
    <Feature Id="AccesoEscritorio" Title="Acceso directo en el escritorio" Level="2">
      <ComponentRef Id="AccesoEscritorioComp" />
    </Feature>

    <!--
      Registro del Sparse Package. Impersonate="yes": Add-AppxPackage registra para el USUARIO que ejecuta (con
      Impersonate="no" seria para SYSTEM y la app no vera la identidad). Return="ignore": sin identidad la app funciona
      igual. Un deferred no resuelve [Propiedades]: la carpeta de trabajo (Directory) es la de instalacion y los scripts
      se localizan con $PSScriptRoot.
    -->
    <CustomAction Id="RegistrarSparse" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File registrar-sparse.ps1" />
    <CustomAction Id="QuitarSparse" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File quitar-sparse.ps1" />

    <!--
      Windows App Runtime 1.5 (Framework x64 y DDLM): la app no arranca sin el. MSI no sabe de paquetes AppX ni hay una clave de registro
      estable (HKLM/SOFTWARE/Microsoft/WindowsAppRuntime/1.5 no existe), asi que un CustomAction de JScript ejecuta detectar-runtime.ps1
      (codificado en base64 dentro de detectar-runtime.js; preparar-instalador.ps1 comprueba que coincide) y deja WINAPPRUNTIME_INSTALLED
      en 1 o 0. Va como Binary (con ScriptSourceFile, WiX lo guarda en la columna Target, de 255 caracteres, y ICE03 avisa del desbordamiento). Return="ignore": si el propio script falla, la propiedad queda en 0.
      SKIP_WINAPPRUNTIME_CHECK=1 se salta la comprobacion (por si el script no puede ejecutarse en algun equipo).
    -->
    <!--
      DECISION (P10): el Windows App Runtime 1.5 es un PRERREQUISITO que el instalador COMPRUEBA, no que descarga ni incluye. Se valoro que una CustomAction
      lo bajase de https://aka.ms/windowsappsdk/1.5/latest/windowsappruntimeinstall-x64.exe y lo ejecutase cuando WINAPPRUNTIME_INSTALLED = "0", y se descarto por ahora:
       - Seria bajar y ejecutar un .exe de internet con permisos de administrador dentro de una accion diferida de MSI. Las reglas del actualizador (ADR-0003) lo
         exigen con sha256 y firma verificados; Microsoft no publica un sha256 estable para el enlace «latest», y fijar el firmante (Microsoft Corporation) es codigo
         que aqui no se puede probar: instalar el .msi pide elevacion y registraria cosas en el equipo.
       - Sin red, o con un proxy, fallaria a mitad de la instalacion con un error de MSI poco claro (una accion diferida no puede mostrar mensajes utiles).
       - Incluir los 64 MB del instalador dentro del .msi tampoco es mejor: hay que actualizarlo con cada parche del runtime.
      Lo correcto, cuando se pruebe el instalador en un Windows limpio y haya firma, es un bundle de WiX Burn (extension WixToolset.Bal.wixext) con un ExePackage para
      WindowsAppRuntimeInstall-x64.exe: DetectCondition, Hash y firma fijados, interfaz y reintentos. Mientras tanto, este aviso con el enlace y windows/README.md.
    -->
    <Property Id="WINAPPRUNTIME_INSTALLED" Value="0" Secure="yes" />
    <Property Id="SKIP_WINAPPRUNTIME_CHECK" Value="0" Secure="yes" />
    <Binary Id="DetectarRuntimeJs" SourceFile="$(sys.SOURCEFILEDIR)detectar-runtime.js" />
    <CustomAction Id="DetectarWindowsAppRuntime" BinaryRef="DetectarRuntimeJs" JScriptCall="DetectarWindowsAppRuntime"
                  Execute="immediate" Return="ignore" />
    <Launch Condition="Installed OR WINAPPRUNTIME_INSTALLED = &quot;1&quot; OR SKIP_WINAPPRUNTIME_CHECK = &quot;1&quot;"
            Message="Terminal NetDeck necesita el Windows App Runtime 1.5.&#10;Descárgalo en: https://aka.ms/windowsappsdk/1.5/latest/windowsappruntimeinstall-x64.exe&#10;Instálalo y vuelve a ejecutar este instalador." />
    <InstallUISequence>
      <Custom Action="DetectarWindowsAppRuntime" Before="LaunchConditions" Condition="NOT Installed" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="DetectarWindowsAppRuntime" Before="LaunchConditions" Condition="NOT Installed" />
      <Custom Action="RegistrarSparse" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="QuitarSparse" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
