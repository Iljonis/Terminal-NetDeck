<?xml version="1.0" encoding="utf-8"?>
<!-- Textos en castellano de la interfaz estándar de WiX (tema hyperlinkLicense) para NetDeckBundle.wxs. Mismos Id que el
     HyperlinkTheme.wxl de WixToolset.Bal.wixext 4.0.6 (que solo trae inglés): si se actualiza la extensión, comparar. -->
<WixLocalization Culture="es-es" Language="3082" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Instalación de [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Buscando actualizaciones" />
  <String Id="UpdateButton" Value="&amp;Actualizar a la versión [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Bienvenido" />
  <String Id="InstallMessage" Value="Se instalará [WixBundleName] en este equipo, con el Windows App Runtime 1.5 si falta. Pulsa Instalar para continuar o Cancelar para salir." />
  <String Id="InstallMessageOptions" Value="Se instalará [WixBundleName] en este equipo, con el Windows App Runtime 1.5 si falta. Pulsa Instalar para continuar, Opciones para cambiar la instalación o Cancelar para salir." />
  <String Id="InstallVersion" Value="Versión [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="¿Seguro que quieres cancelar?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Versión anterior" />
  <String Id="HelpHeader" Value="Ayuda de la instalación" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [carpeta] - instala, repara, desinstala o&#xA;   copia el instalador completo en la carpeta. Por defecto, instala.&#xA;&#xA;/passive | /quiet - muestra una interfaz mínima sin preguntas, o ninguna interfaz&#xA;   y ninguna pregunta. Por defecto se muestran la interfaz y las preguntas.&#xA;&#xA;/norestart   - no reinicia el equipo. Por defecto pregunta antes de reiniciar.&#xA;/log log.txt - escribe el registro en ese archivo. Por defecto va a %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Cerrar" />
  <String Id="InstallLicenseLinkText" Value="&lt;a href=&quot;#&quot;&gt;Licencia&lt;/a&gt; de [WixBundleName]." />
  <String Id="InstallAcceptCheckbox" Value="&amp;Acepto la licencia" />
