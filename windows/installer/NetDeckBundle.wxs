<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador de un paso de Terminal NetDeck para Windows (WiX Toolset 4, Burn): Terminal-NetDeck-X.Y.Z-Setup.exe.
  Es lo que se descarga para instalar. Encadena, en este orden:
    1. el redistribuible oficial de Windows App Runtime 1.5 (WindowsAppRuntimeInstall-x64.exe, en silencio), que la app
       necesita para arrancar. Si ya esta instalado, no hace nada (lo dice la guia de despliegue de Microsoft). Va DENTRO
       del .exe: funciona sin red y con proxy (bajarlo durante la instalacion es lo que se descarto en P10).
    2. el .msi de siempre (NetDeckWindows.wxs), que sigue publicandose suelto para despliegues gestionados (msiexec /qn).

  El redistribuible lo baja build-bundle.ps1 de la URL fija de windows-app-runtime.json y comprueba su sha256 y la firma de
  Microsoft antes de compilar. Uso:
      powershell.exe -NoProfile -ExecutionPolicy Bypass -File windows/installer/build-bundle.ps1 -Msi <ruta del .msi> [-Out ...]
  Necesita la extension WixToolset.Bal.wixext 4.0.6 (build-bundle.ps1 la anade si falta).

  El runtime es Permanent: desinstalar Terminal NetDeck no lo quita (es un componente de Windows que usan otras apps). Sin
  DetectCondition, Burn lo ejecuta en cada instalacion o actualizacion; el instalador de Microsoft sale enseguida con 0 si
  ya estan todos sus paquetes. Va elevado (PerMachine): aprovisiona el runtime para todos los usuarios.

  Una sola entrada en «Aplicaciones instaladas»: la del bundle (Burn instala el .msi oculto, ARPSYSTEMCOMPONENT). El
  actualizador de la app (UpdateCheck.candidate) prefiere el Setup.exe al .msi para no dejar dos entradas.

  La version llega de fuera (-d Version=..., la misma que el .msi). El UpgradeCode del bundle no se cambia nunca.
-->
<?ifndef Version?>
<?define Version = "1.0.1"?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Terminal NetDeck"
          Manufacturer="Iljonis"
          Version="$(var.Version)"
          UpgradeCode="D40D0456-5671-42DC-85DC-223E34495E9B"
          IconSourceFile="$(var.Assets)\NetDeck.ico"
          AboutUrl="https://github.com/Iljonis/Terminal-NetDeck"
          HelpUrl="https://github.com/Iljonis/Terminal-NetDeck/issues"
          UpdateUrl="https://github.com/Iljonis/Terminal-NetDeck/releases/latest"
          DisableModify="yes">

    <!-- Una pantalla: el enlace a la licencia (MIT) y «Instalar». Sin opciones (la carpeta es la del .msi). -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              LicenseUrl="https://github.com/Iljonis/Terminal-NetDeck/blob/main/LICENSE"
                                              LogoFile="$(var.Assets)\Square150x150Logo.png"
                                              SuppressOptionsUI="yes"
                                              SuppressRepair="yes"
                                              ShowVersion="yes" />
      <!-- Textos en castellano. La interfaz estandar solo trae ingles (thm.wxl); Burn busca <idioma>\thm.wxl con el idioma
           de la interfaz de Windows y, si no, el idioma principal: 3082 (es-ES), 1034 (es-ES tradicional) y 10 (cualquier
           espanol). En cualquier otro idioma, en ingles. -->
      <Payload Id="TextosEs3082" Name="3082\thm.wxl" SourceFile="$(sys.SOURCEFILEDIR)bundle-es.wxl" />
      <Payload Id="TextosEs1034" Name="1034\thm.wxl" SourceFile="$(sys.SOURCEFILEDIR)bundle-es.wxl" />
      <Payload Id="TextosEs10" Name="10\thm.wxl" SourceFile="$(sys.SOURCEFILEDIR)bundle-es.wxl" />
    </BootstrapperApplication>

    <!-- Windows de 64 bits (la app y el .msi son x64). -->
    <bal:Condition Message="Terminal NetDeck necesita Windows 10 o 11 de 64 bits." Condition="VersionNT64" />

    <Chain>
      <!-- Codigos de salida de la guia de Microsoft: 0 = bien (tambien si ya estaba). Cualquier otro es un fallo y se
           deshace la instalacion (Vital): 0x80073D06 = fallo algun paquete, 0x80070005 = sin elevacion. -->
      <ExePackage Id="WindowsAppRuntime15"
                  DisplayName="Windows App Runtime 1.5"
                  SourceFile="$(var.RuntimeInstaller)"
                  Name="WindowsAppRuntimeInstall-x64.exe"
                  InstallArguments="--quiet"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes">
        <ExitCode Value="0" Behavior="success" />
      </ExePackage>

      <MsiPackage Id="TerminalNetDeck"
                  SourceFile="$(var.Msi)"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
