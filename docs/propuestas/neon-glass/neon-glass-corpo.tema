# Neón Corpo — Torre corporativa de cristal ahumado: rojo de alarma, cromo blanco y nada que sobre.
# Temática de la app (estilo «cristal» con alma de neón: barra, pestañas y menús de vidrio; el terminal, casi opaco).

nombre    = Neón Corpo
grupo     = Neon Glass
orden     = 05
estilo    = cristal
material  = cristal
brillo    = sí                           # (propuesta)
tinte     = #e4002b26                    # (propuesta)
fuentes   = IBM Plex Mono, Red Hat Mono, Geist Mono      # la 1ª es la oficial; las otras, recomendadas
fuente_interfaz = sistema
tamaño    = 14

fondo         = #0e0a0bcc                # negro ahumado con un punto de rojo (cc ≈ 80 %)
texto         = #f2eeee
barra         = #2a0a0e66
panel         = #3a141a80
pestaña       = #e4002b                  # rojo corporativo
sobre_pestaña = #ffffff
acento        = #f0f0f5                  # cromo
acento2       = #ff5c78
bien          = #7dffb2
mal           = #ff2b3d
especial      = #ff8fa3
apagado       = #9a8a8e
menu          = ▌企業 · NetDeck
reloj         = 時 %H:%M
